# ── Feedback email notifications ───────────────────────────────
# Uses the OS sendmail command (postfix/exim must be configured on the server).
# Leave blank to disable email — messages are still saved to SQLite.
# Set this during deploy.sh setup, or edit this file directly on the server.
NOTIFY_EMAIL=
NOTIFY_EMAIL_2=

# ── Temp Inbox (throwaway email tool) ──────────────────────────
# Domain that throwaway addresses are minted under (e.g. inbox.grin.money).
# Leave blank to disable the Temp Inbox tool (the other email tools work without it).
# To actually RECEIVE mail you must also: (1) add an MX record for this domain
# pointing at this server, and (2) configure your MTA (postfix/exim) to pipe inbound
# messages to POST /api/email/inbox/ingest with the X-Ingest-Secret header below.
TEMP_INBOX_DOMAIN=
# Shared secret the MTA must send as the X-Ingest-Secret header on /api/email/inbox/ingest.
INBOX_INGEST_SECRET=
# Minutes an inbox lives before it (and its mail) is auto-pruned. Default 60.
TEMP_INBOX_TTL_MIN=60

# ── Server ─────────────────────────────────────────────────────
PORT=3001
# Interface to bind. 127.0.0.1 = reachable only through the local nginx proxy (what
# deploy.sh writes); unset = all interfaces.
HOST=127.0.0.1

# Per-IP/min cap for the public port-check probe endpoints (default 600, clamp 10–2000).
PROBE_RATE_PER_MIN=600

# Google Gemini key for /api/domain/ai-suggest (Domain Checker AI suggestions).
# Leave blank to disable that feature; the endpoint then answers 503.
GEMINI_API_KEY=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,https://yourdomain.com

# ── SQLite / uploads ───────────────────────────────────────────
TOOLS_DB=/opt/office-tools/data/tools.db
UPLOADS_DIR=/opt/office-tools/data/uploads

# ── File Drop — TURN relay (WebRTC fallback) ───────────────────
# Same-Wi-Fi transfers fail on routers with AP/client isolation and on
# restrictive NATs because STUN alone cannot relay. coturn provides a relay;
# the /api/tools/turn endpoint mints SHORT-LIVED credentials from the shared
# secret below (coturn `use-auth-secret` scheme) so no long-lived TURN password
# is ever exposed in the public page. deploy.sh sets these up automatically.
# Leave TURN_SECRET/TURN_URLS blank to disable TURN → File Drop uses direct P2P.
#   TURN_URLS   comma-separated turn:/turns: URIs (e.g. turn:example.com:3478?transport=udp)
#   TURN_SECRET must match coturn's static-auth-secret in /etc/turnserver.conf
#   TURN_TTL    credential lifetime in seconds (default 3600, clamp 300–86400)
#   STUN_URLS   optional override of the STUN servers (defaults to Cloudflare + Google)
TURN_URLS=
TURN_SECRET=
TURN_TTL=3600
STUN_URLS=

# ── Abuse limits (all optional; the values shown are the defaults) ──────────
# Extra public IPs of THIS server that outbound tools must refuse to connect to.
# Interface addresses are detected automatically; set this only behind 1:1 NAT,
# where the public address is not on a network interface. Comma-separated.
SELF_IPS=
# Port checker: probes allowed against one destination per 10 minutes (all callers),
# sockets open at once, and probes allowed to wait for a socket.
PROBE_TARGET_PER_10MIN=1200
PROBE_MAX_SOCKETS=256
PROBE_MAX_QUEUE=1024
# AI domain suggestions: calls per UTC day across all visitors.
AI_SUGGEST_DAILY_MAX=500
# Directory whose sub-folder names are the valid tool ids for view counting.
# Defaults to /var/www/office-tools/tools.
TOOLS_DIR=
